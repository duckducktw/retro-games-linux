#!/usr/bin/env bash
# Win95 Solitaire (Bottles bottle "Solitaire") — single-instance launcher
set -u
BOTTLE="${BOTTLE_NAME:-Solitaire}"

if pgrep -f "[S]OL\.EXE" >/dev/null 2>&1; then
    notify-send -a Solitaire "接龍已在執行" "視窗請從工作列的 Solitaire 點開" 2>/dev/null || true
    exit 0
fi

export DISPLAY="${DISPLAY:-:0}"
exec flatpak run --command=bottles-cli com.usebottles.bottles \
    run -b "$BOTTLE" -e 'C:\Solitaire\SOL.EXE'
